            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
    onCompleteTask:
      m_PersistentCalls:
        m_Calls: []
  - msg: Hey there Intern! Looks like by process of elimination you've been selected!
      Come see me in my office to grab that long awaited new position!
