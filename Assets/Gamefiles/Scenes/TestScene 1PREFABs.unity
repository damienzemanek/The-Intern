  internData:
  - internName: 
    deathReason: Unauthorized removal of limbs from body during minor printer malfunction.
    spr_deathStickyNote: {fileID: 0}
  - internName: 
    deathReason: Employee ignored company policy of not drowing on company grounds.
      Refer to Company Policy Section B.45.724.0002
    spr_deathStickyNote: {fileID: 0}
  - internName: 
    deathReason: Bled out all over our company's luxery egyptian cotton carpet floor
      without asking permission.
    spr_deathStickyNote: {fileID: 0}
  - internName: 
    deathReason: 
    spr_deathStickyNote: {fileID: 0}
  tasks:
  - msg: Hey! Welcome to the Team! Go ahead and setup at desk 5.
    isComplete: 0
    go_taskGrouping: {fileID: 361061804146973806}
    onStartTask:
      m_PersistentCalls:
        m_Calls: []
    onCompleteTask:
      m_PersistentCalls:
        m_Calls: []
  - msg: 'Great! I have your first task today, I need you to use the Printer to print
      some Important Documents for Jim. Just make sure you re-fill it with new paper,
      there is some on your desk. '
    isComplete: 0
    go_taskGrouping: {fileID: 7466910192414773189}
    onStartTask:
      m_PersistentCalls:
        m_Calls: []
    onCompleteTask:
      m_PersistentCalls:
        m_Calls: []
  - msg: Great work! Tell Jim to look alive! He's got a report to get to me on those
      documents. Oh, and Clarence is asking me, to ask you to refill his coffee mug.
      He's at his desk. Chop chop Intern.
    isComplete: 0
    go_taskGrouping: {fileID: 2138370350989068463}
    onStartTask:
      m_PersistentCalls:
        m_Calls: []
    onCompleteTask:
      m_PersistentCalls:
        m_Calls: []
  - msg: Thanks for re-filling Clarence's coffee! You've been a real team player!
      Why don't you ask him if he likes it?
    isComplete: 0
    go_taskGrouping: {fileID: 753165007993304382}
    onStartTask:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 7257819111865919791}
